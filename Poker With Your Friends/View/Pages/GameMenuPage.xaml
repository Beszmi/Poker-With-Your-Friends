<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Poker_With_Your_Friends.GameMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Poker_With_Your_Friends"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Model="using:Poker_With_Your_Friends.Model"
    xmlns:View="using:Poker_With_Your_Friends.View"
    xmlns:ViewModel="using:Poker_With_Your_Friends.ViewModel"
    mc:Ignorable="d">

    <!--
    Table tempalte
    -->
    <Page.Resources>
        <DataTemplate x:Key="TableItemTemplate" x:DataType="Model:Table">
            <Grid Height="400" Width="400">
                <Image Source="/Assets/Table.png" />
                <TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="28" Foreground="Red" Margin="0,110,0,0" MaxWidth="165"/>
                <StackPanel Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock FontSize="18" Margin="0,70,0,0">
                        <Run Text="{x:Bind Model:Utils.NumberToOrdinalNumber(Round), Mode=OneWay}"/>
                        <Run Text=" Round"/>
                        <LineBreak/>
                        <Run Text="Players: "/>
                        <Run Text="{x:Bind Players.Count, Mode=OneWay}"/>
                        <LineBreak/>
                        <Run Text="Pot: "/>
                        <Run Text="{x:Bind Pot, Mode=OneWay}"/>
                        <LineBreak/>
                        <Run Text="Small blind: "/>
                        <Run Text="{x:Bind SmallBlind, Mode=OneWay}"/>
                        <Run Text="$"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AddTableItemTemplate" x:DataType="ViewModel:AddTableMenuItem">
            <Grid Height="400" Width="400">
                <Image Source="/Assets/Table.png" Opacity="0.65"/>
                <TextBox Text="{x:Bind Owner.NewTableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Table name" VerticalAlignment="Top"
                         HorizontalAlignment="Center" FontSize="28" Foreground="Red" Margin="0,110,0,0" Width="165" KeyDown="NewTableNameTextBox_KeyDown"/>
                <Button Content="+ Create table" HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="{x:Bind Owner.IsNewTableButtonEnabled, Mode=OneWay}" Click="CreateTableButton_Click"/>
            </Grid>
        </DataTemplate>

        <View:GameMenuItemTemplateSelector
            x:Key="GameMenuItemTemplateSelector"
            TableTemplate="{StaticResource TableItemTemplate}"
            AddTableTemplate="{StaticResource AddTableItemTemplate}"/>
    </Page.Resources>

    <Grid RequestedTheme="Light">
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Table_Picker_BG.jpg" Stretch="UniformToFill" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
        Player info
        -->
        <Border Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#358854" Padding="2" BorderBrush="Black" BorderThickness="1" CornerRadius="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Click="PickFileButton_Click"  Padding="0" Background="Transparent" BorderThickness="0" Margin="5">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                        </Button.Resources>
                        <Border Width="100" Height="100" CornerRadius="90" BorderBrush="Black" BorderThickness="1">
                            <Image Source="{x:Bind Model:Utils.PathToImage(viewModel.PlayerStore.CurrentPlayer.ProfilePictureDir), Mode=OneWay}" Stretch="Fill" />
                        </Border>
                    </Button>
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center">
                        <Run FontSize="28" Text="{x:Bind viewModel.PlayerStore.CurrentPlayer.Name, Mode=OneWay}"/>
                        <LineBreak/>
                        <Run FontSize="18" Text="Chips: "/>
                        <Run FontSize="18" Text="{x:Bind viewModel.PlayerStore.CurrentPlayer.Chips, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!--
        Tables grid
        -->
        <GridView Grid.Row="1" ItemsSource="{x:Bind viewModel.TableMenuItems, Mode=OneWay}" ItemClick="Table_ItemClick" IsItemClickEnabled="True" ItemTemplateSelector="{StaticResource GameMenuItemTemplateSelector}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>
    </Grid>
</Page>
