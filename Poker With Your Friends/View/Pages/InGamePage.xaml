<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Poker_With_Your_Friends.InGamePage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Poker_With_Your_Friends"
    xmlns:Model="using:Poker_With_Your_Friends.Model"
    xmlns:vm="using:Poker_With_Your_Friends.ViewModel"
    xmlns:controls="using:Poker_With_Your_Friends.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:Templates/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid RequestedTheme="Light">
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/In_Game_BG.jpg" 
                Stretch="UniformToFill" 
                AlignmentY="Top" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Grid.Row="0" Content="EXIT" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Click="LeaveTableButton_Click" IsEnabled="{x:Bind viewModel.LeaveTableButtonEnabled, Mode=OneWay}" Background="Red"/>

        <TextBlock Grid.Column="1" Grid.Row="0" Margin="0,20,0,0" FontSize="28" FontFamily="Arial Black" HorizontalAlignment="Center" >
            <Run Text="{x:Bind viewModel.Table.Pot, Mode=OneWay}"/>
            <Run Text="$"/>
        </TextBlock>

        <Button Grid.Column="2" Grid.Row="0" Content="➕Join Game" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Click="JoinGameButton_Click" Visibility="{x:Bind viewModel.IsJoinButtonVisible, Mode=OneWay}" Background="Green"/>
        <Button Grid.Column="2" Grid.Row="0" Content="➖Leave Game" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Click="LeaveGameButton_Click" Visibility="{x:Bind viewModel.IsLeaveButtonVisible, Mode=OneWay}" Background="Green"/>

        <Image Source="/Assets/cardEmpty.png" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="0,35,0,0" Width="180" Height="252"/>

        <ListView Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" ItemsSource="{x:Bind viewModel.Table.Housecards, Mode=OneWay}" Margin="0,80,0,0">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="Model:Card">
                    <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource HouseCardTemplate}" Margin="5,0,5,0"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="24" Margin="0,20,0,0" Text="{x:Bind viewModel.Table.TableText, Mode=OneWay}"/>

        <TextBlock Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10">
            <Run Text="Pot: "/>
            <Run Text="{x:Bind viewModel.Table.Pot, Mode=OneWay}"/>
            <LineBreak/>
            <Run Text="Round: "/>
            <Run Text="{x:Bind viewModel.Table.Round, Mode=OneWay}"/>
            <LineBreak/>
            <Run Text="Small blind: "/>
            <Run Text="{x:Bind viewModel.Table.SmallBlind, Mode=OneWay}"/>
            <Run Text="$"/>
            <LineBreak/>
            <Run Text="To call: "/>
            <Run Text="{x:Bind viewModel.Table.ToCall, Mode=OneWay}"/>
            <Run Text="$"/>
        </TextBlock>

        <ItemsControl Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="3" Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemsSource="{x:Bind viewModel.PlayerSeats, Mode=OneWay}" ItemTemplate="{StaticResource PlayerSeatTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:SemicirclePlayerPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <StackPanel Grid.Column="2" Grid.Row="4" Orientation="Vertical"
                    Visibility="{x:Bind viewModel.IsJoinButtonVisible, Mode=OneWay}">
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                <Run Text="Time left: "/>
                <Run Text="{x:Bind viewModel.TimerRemainingText, Mode=OneWay}"/>
                <Run Text=" Seconds"/>
            </TextBlock>
            <ProgressBar Minimum="0" Maximum="{x:Bind viewModel.TimerProgressMaximum, Mode=OneWay}" Width="300" Value="{x:Bind viewModel.TimerProgressValue, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
