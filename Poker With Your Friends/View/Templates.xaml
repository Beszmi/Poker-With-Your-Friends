<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Poker_With_Your_Friends.Templates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Poker_With_Your_Friends"
    xmlns:Model="using:Poker_With_Your_Friends.Model"
    xmlns:vm="using:Poker_With_Your_Friends.ViewModel">

    <LinearGradientBrush x:Key="GrayRedStripeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="DimGray" Offset="0.0" />
        <GradientStop Color="DimGray" Offset="0.2" />
        <GradientStop Color="Firebrick" Offset="0.2" />
        <GradientStop Color="Firebrick" Offset="0.4" />
        <GradientStop Color="DimGray" Offset="0.4" />
        <GradientStop Color="DimGray" Offset="0.6" />
        <GradientStop Color="Firebrick" Offset="0.6" />
        <GradientStop Color="Firebrick" Offset="0.8" />
        <GradientStop Color="DimGray" Offset="0.8" />
        <GradientStop Color="DimGray" Offset="1.0" />
    </LinearGradientBrush>

    <DataTemplate x:Key="CardTemplate" x:DataType="Model:Card">
        <Canvas Width="100" Height="140">
            <Border Width="100" Height="140" BorderBrush="Black" BorderThickness="2" CornerRadius="10" Background="White">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
            </Border>
            <TextBlock Text="{x:Bind ValueSymbol}" Foreground="{x:Bind Color}" FontSize="20" Canvas.Left="10" Canvas.Top="5"/>
            <TextBlock Text="{x:Bind SuitSymbol}" Foreground="{x:Bind Color}" FontSize="20" Canvas.Left="10" Canvas.Top="20"/>
        </Canvas>
    </DataTemplate>

    <DataTemplate x:Key="HouseCardTemplate" x:DataType="Model:Card">
        <Canvas Width="180" Height="252">
            <Border Width="180" Height="252" BorderBrush="Black" BorderThickness="2" CornerRadius="10" Background="White">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
            </Border>
            <TextBlock Text="{x:Bind ValueSymbol}" Foreground="{x:Bind Color}" FontSize="20" Canvas.Left="10" Canvas.Top="5"/>
            <TextBlock Text="{x:Bind SuitSymbol}" Foreground="{x:Bind Color}" FontSize="20" Canvas.Left="10" Canvas.Top="20"/>
        </Canvas>
    </DataTemplate>

    <DataTemplate x:Key="CurrentPlayerTemplate" x:DataType="vm:PlayerSeatViewModel">
        <Grid MinHeight="150" MinWidth="300">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Rectangle Grid.Row="0" Height="25" HorizontalAlignment="Stretch" Fill="#00000000" />

            <Border Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" CornerRadius="10">
                <Rectangle Fill="{x:Bind Player.BgColor, Mode=OneWay}" />
            </Border>

            <Grid Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top"
                           Text="You won! 🥳🥳🥳"
                           Visibility="{x:Bind Owner.IsCurrentPlayerWinner, Mode=OneWay}"/>

                <StackPanel Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5" Margin="15">
                    <ListView ItemsSource="{x:Bind Player.Cards, Mode=OneWay}">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="Model:Card">
                                <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource CardTemplate}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock HorizontalAlignment="Center" Text="{x:Bind Owner.CurrentPlayerHandName, Mode=OneWay}"/>
                </StackPanel>

                <Border Grid.Column="0" Grid.Row="2" Width="50" Height="50" CornerRadius="10" BorderBrush="Black" BorderThickness="1" Margin="5">
                    <Image Source="{x:Bind Model:Utils.PathToImage(Player.ProfilePictureDir), Mode=OneWay}" Stretch="Fill"/>
                </Border>

                <TextBlock Grid.Column="1" Grid.Row="2" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Run Text="Chips: $"/>
                    <Run Text="{x:Bind Player.Chips, Mode=OneWay}"/>
                </TextBlock>

                <Border Grid.Column="2" Grid.Row="2" CornerRadius="5" BorderBrush="Black" BorderThickness="1" Margin="5"
                        Visibility="{x:Bind Model:Utils.BoolToVis(Owner.PlayerActionButtonsEnabled), Mode=OneWay}">
                    <StackPanel Spacing="2">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Your turn" FontFamily="Arial Narrow" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Bind Owner.TimerRemainingText, Mode=OneWay}" FontFamily="Arial Black" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Grid.Row="2" CornerRadius="5" BorderBrush="Black" BorderThickness="1" Margin="5"
                        Visibility="{x:Bind Model:Utils.AntiBoolToVis(Owner.PlayerActionButtonsEnabled), Mode=OneWay}">
                    <StackPanel Spacing="2">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Waiting" FontFamily="Arial Narrow" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Bind Owner.TimerRemainingText, Mode=OneWay}" FontFamily="Arial Black" />
                    </StackPanel>
                </Border>

                <Image Grid.Column="2" Grid.Row="0" Width="50" Height="50" Source="/Assets/SmallBlind.png"
                       Visibility="{x:Bind vm:InGamePageViewModel.ConvertBlind(Player.Blind, Model:BlindEnum.SmallBlind), Mode=OneWay}"/>
                <Image Grid.Column="2" Grid.Row="0" Width="50" Height="50" Source="/Assets/BigBlind.png"
                       Visibility="{x:Bind vm:InGamePageViewModel.ConvertBlind(Player.Blind, Model:BlindEnum.BigBlind), Mode=OneWay}"/>
                <Image Grid.Column="2" Grid.Row="0" Width="50" Height="50" Source="/Assets/NotBlind.png"
                       Visibility="{x:Bind vm:InGamePageViewModel.ConvertBlind(Player.Blind, Model:BlindEnum.NotBlind), Mode=OneWay}"/>

                <StackPanel Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="3" Orientation="Vertical"
                            Visibility="{x:Bind Model:Utils.AntiBoolToVis(Owner.Table.IsShowdown), Mode=OneWay}">
                    <TextBlock HorizontalAlignment="Center" Text="{x:Bind Owner.SelectedRaiseValue, Mode=OneWay}"/>
                    <Slider Minimum="{x:Bind Owner.RaiseMin, Mode=OneWay}"
                            Maximum="{x:Bind Owner.RaiseMax, Mode=OneWay}"
                            Value="{x:Bind Owner.SelectedRaiseValue, Mode=TwoWay}"
                            IsEnabled="{x:Bind Owner.IsRaiseButtonEnabled, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button VerticalAlignment="Bottom" Content="{x:Bind Owner.CallButtonText, Mode=OneWay}"
                            IsEnabled="{x:Bind Owner.CallButtonEnabled, Mode=OneWay}"
                            Visibility="{x:Bind Model:Utils.AntiBoolToVis(Owner.Table.IsShowdown), Mode=OneWay}"
                            Command="{x:Bind Owner.CallCommand}" Background="LightGreen"/>
                    <Button Content="Raise" IsEnabled="{x:Bind Owner.IsRaiseButtonEnabled, Mode=OneWay}"
                            Command="{x:Bind Owner.RaiseCommand}" Background="LightBlue"/>
                    <Button VerticalAlignment="Bottom" Content="Fold"
                            IsEnabled="{x:Bind Owner.PlayerActionButtonsEnabled, Mode=OneWay}"
                            Command="{x:Bind Owner.FoldCommand}" Background="{StaticResource GrayRedStripeBrush}" />
                    <Button VerticalAlignment="Bottom" Content="AllIn"
                            IsEnabled="{x:Bind Owner.AllInButtonEnabled, Mode=OneWay}"
                            Visibility="{x:Bind Model:Utils.AntiBoolToVis(Owner.Table.IsShowdown), Mode=OneWay}"
                            Command="{x:Bind Owner.AllInCommand}" Background="Red"/>
                    <Button VerticalAlignment="Bottom" Content="Show Cards"
                            IsEnabled="{x:Bind Owner.ShowCardsButtonEnabled, Mode=OneWay}"
                            Visibility="{x:Bind Owner.ShowCardsButtonVisible, Mode=OneWay}"
                            Command="{x:Bind Owner.ShowCardsCommand}" Background="Gold"/>
                    <Button VerticalAlignment="Bottom" Content="Reveal Cards"
                            Command="{x:Bind Owner.RevealCardsCommand}"
                            Visibility="{x:Bind Owner.RevealCardsButtonVisible, Mode=OneWay}"/>
                </StackPanel>

                <ProgressBar Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="3" Minimum="0"
                             Maximum="{x:Bind Owner.TimerProgressMaximum, Mode=OneWay}"
                             Width="300" Value="{x:Bind Owner.TimerProgressValue, Mode=OneWay}" Margin="0,2,0,5" />
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PlayerEndOfRound" x:DataType="Model:Player">
        <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{x:Bind BgColorTransparent, Mode=OneWay}" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5" Margin="15">
                <ListView ItemsSource="{x:Bind Cards, Mode=OneWay}" Visibility="{x:Bind Model:Utils.BoolToVis(CardsRevealed), Mode=OneWay}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="Model:Card">
                            <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource CardTemplate}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock HorizontalAlignment="Center" Text="{x:Bind HandName, Mode=OneWay}" Visibility="{x:Bind Model:Utils.BoolToVis(CardsRevealed), Mode=OneWay}"/>
            </StackPanel>

            <Border Grid.Column="0" Grid.Row="1" Width="50" Height="50" CornerRadius="10" BorderBrush="Black" BorderThickness="1" Margin="2" Visibility="{x:Bind Model:Utils.AntiBoolToVis(IsCurrentlyActivePlayer), Mode=OneWay}">
                <Image Source="{x:Bind Model:Utils.PathToImage(ProfilePictureDir), Mode=OneWay}" Stretch="Fill"/>
            </Border>

            <Border Grid.Column="0" Grid.Row="1" Width="60" Height="60" CornerRadius="10" BorderBrush="Yellow" BorderThickness="2" Margin="2" Visibility="{x:Bind Model:Utils.BoolToVis(IsCurrentlyActivePlayer), Mode=OneWay}">
                <Image Source="{x:Bind Model:Utils.PathToImage(ProfilePictureDir), Mode=OneWay}" Stretch="Fill"/>
            </Border>

            <Border Grid.Column="1" Grid.Row="2" Background="#66111111" HorizontalAlignment="Center">
                <TextBlock  FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"  Foreground="White">
                    <Run Text="$"/>
                    <Run Text="{x:Bind Chips, Mode=OneWay}"/>
                </TextBlock>
            </Border>

            <Image Grid.Column="2" Grid.Row="1" Width="50" Height="50" Source="/Assets/SmallBlind.png" Visibility="{x:Bind vm:InGamePageViewModel.ConvertBlind(Blind, Model:BlindEnum.SmallBlind), Mode=OneWay}"/>
            <Image Grid.Column="2" Grid.Row="1" Width="50" Height="50" Source="/Assets/BigBlind.png" Visibility="{x:Bind vm:InGamePageViewModel.ConvertBlind(Blind, Model:BlindEnum.BigBlind), Mode=OneWay}"/>
            <Image Grid.Column="2" Grid.Row="1" Width="50" Height="50" Source="/Assets/NotBlind.png" Visibility="{x:Bind vm:InGamePageViewModel.ConvertBlind(Blind, Model:BlindEnum.NotBlind), Mode=OneWay}"/>

            <Border Width="Auto" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="2" BorderBrush="Black" BorderThickness="1" Background="{x:Bind vm:InGamePageViewModel.LastActionToColor(LastAction), Mode=OneWay}" Visibility="{x:Bind vm:InGamePageViewModel.LastActionVisibility(LastAction), Mode=OneWay}">
                <TextBlock Text="{x:Bind LastAction, Mode=OneWay}" Margin="5" FontSize="18" FontWeight="Bold"/>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PlayerBeforeEndOfRound" x:DataType="Model:Player">
        <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{x:Bind BgColorTransparent, Mode=OneWay}" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Visibility="{Binding viewModel.CardsDealt, ElementName=RootPage}">
                <Image Source="/Assets/cardEmpty.png" Width="100" Height="140"/>
                <Image Source="/Assets/cardEmpty.png" Width="100" Height="140"/>
            </StackPanel>

            <Border Grid.Column="0" Grid.Row="1" Width="50" Height="50" CornerRadius="10" BorderBrush="Black" BorderThickness="1" Margin="2" Visibility="{x:Bind Model:Utils.AntiBoolToVis(IsCurrentlyActivePlayer), Mode=OneWay}">
                <Image Source="{x:Bind Model:Utils.PathToImage(ProfilePictureDir), Mode=OneWay}" Stretch="Fill"/>
            </Border>

            <Border Grid.Column="0" Grid.Row="1" Width="60" Height="60" CornerRadius="10" BorderBrush="Yellow" BorderThickness="2" Margin="2" Visibility="{x:Bind Model:Utils.BoolToVis(IsCurrentlyActivePlayer), Mode=OneWay}">
                <Image Source="{x:Bind Model:Utils.PathToImage(ProfilePictureDir), Mode=OneWay}" Stretch="Fill"/>
            </Border>

            <Border Grid.Column="1" Grid.Row="1" Background="#66111111" HorizontalAlignment="Center">
                <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White">
                    <Run Text="$"/>
                    <Run Text="{x:Bind Chips, Mode=OneWay}"/>
                </TextBlock>
            </Border>

            <Image Grid.Column="2" Grid.Row="1" Width="50" Height="50" Source="/Assets/SmallBlind.png" Visibility="{x:Bind vm:InGamePageViewModel.ConvertBlind(Blind, Model:BlindEnum.SmallBlind), Mode=OneWay}"/>
            <Image Grid.Column="2" Grid.Row="1" Width="50" Height="50" Source="/Assets/BigBlind.png" Visibility="{x:Bind vm:InGamePageViewModel.ConvertBlind(Blind, Model:BlindEnum.BigBlind), Mode=OneWay}"/>
            <Image Grid.Column="2" Grid.Row="1" Width="50" Height="50" Source="/Assets/NotBlind.png" Visibility="{x:Bind vm:InGamePageViewModel.ConvertBlind(Blind, Model:BlindEnum.NotBlind), Mode=OneWay}"/>

            <Border Width="Auto" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="2" BorderBrush="Black" BorderThickness="1" Background="{x:Bind vm:InGamePageViewModel.LastActionToColor(LastAction), Mode=OneWay}" Visibility="{x:Bind vm:InGamePageViewModel.LastActionVisibility(LastAction), Mode=OneWay}">
                <TextBlock Text="{x:Bind LastAction, Mode=OneWay}" Margin="5" FontSize="18" FontWeight="Bold"/>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PlayerSeatTemplate" x:DataType="vm:PlayerSeatViewModel">
        <Grid>
            <ContentControl Content="{x:Bind}"
                            ContentTemplate="{StaticResource CurrentPlayerTemplate}"
                            Visibility="{x:Bind Model:Utils.BoolToVis(IsLocalPlayer)}"/>

            <Grid Visibility="{x:Bind Model:Utils.AntiBoolToVis(IsLocalPlayer)}">
                <ContentControl Content="{x:Bind Player}"
                                ContentTemplate="{StaticResource PlayerEndOfRound}"
                                Visibility="{x:Bind Model:Utils.BoolToVis(UseRevealedTemplate)}"/>
                <ContentControl Content="{x:Bind Player}"
                                ContentTemplate="{StaticResource PlayerBeforeEndOfRound}"
                                Visibility="{x:Bind Model:Utils.AntiBoolToVis(UseRevealedTemplate)}"/>
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
