<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Poker_With_Your_Friends.Templates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Poker_With_Your_Friends"
    xmlns:Model="using:Poker_With_Your_Friends.Model"
    xmlns:vm="using:Poker_With_Your_Friends.ViewModel">

    <DataTemplate x:Key="CardTemplate" x:DataType="Model:Card">
        <Canvas Width="100" Height="140">
            <Border Width="100" Height="140" BorderBrush="Black" BorderThickness="2" CornerRadius="10" Background="White">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
            </Border>
            <TextBlock Text="{x:Bind ValueSymbol}" Foreground="{x:Bind Color}" FontSize="20" Canvas.Left="10" Canvas.Top="5"/>
            <TextBlock Text="{x:Bind SuitSymbol}" Foreground="{x:Bind Color}" FontSize="20" Canvas.Left="10" Canvas.Top="20"/>
        </Canvas>
    </DataTemplate>

    <DataTemplate x:Key="HouseCardTemplate" x:DataType="Model:Card">
        <Canvas Width="180" Height="252">
            <Border Width="180" Height="252" BorderBrush="Black" BorderThickness="2" CornerRadius="10" Background="White">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
            </Border>
            <TextBlock Text="{x:Bind ValueSymbol}" Foreground="{x:Bind Color}" FontSize="20" Canvas.Left="10" Canvas.Top="5"/>
            <TextBlock Text="{x:Bind SuitSymbol}" Foreground="{x:Bind Color}" FontSize="20" Canvas.Left="10" Canvas.Top="20"/>
        </Canvas>
    </DataTemplate>

    <DataTemplate x:Key="PlayerEndOfRound" x:DataType="Model:Player">
        <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{x:Bind BgColorTransparent, Mode=OneWay}" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5" Margin="15">
                <ListView ItemsSource="{x:Bind Cards, Mode=OneWay}" Visibility="{x:Bind Model:Utils.BoolToVis(CardsRevealed), Mode=OneWay}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="Model:Card">
                            <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource CardTemplate}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock HorizontalAlignment="Center" Text="{x:Bind HandName, Mode=OneWay}" Visibility="{x:Bind Model:Utils.BoolToVis(CardsRevealed), Mode=OneWay}"/>
            </StackPanel>

            <Border Grid.Column="0" Grid.Row="2" Width="50" Height="50" CornerRadius="10" BorderBrush="Black" BorderThickness="1" Margin="2">
                <Image Source="{x:Bind Model:Utils.PathToImage(ProfilePictureDir), Mode=OneWay}" Stretch="Fill"/>
            </Border>

            <Border Grid.Column="1" Grid.Row="2" Background="#66111111" HorizontalAlignment="Center">
                <TextBlock  FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Run Text="$"/>
                    <Run Text="{x:Bind Chips, Mode=OneWay}"/>
                </TextBlock>
            </Border>

            <Image Grid.Column="2" Grid.Row="1" Width="50" Height="50" Source="/Assets/SmallBlind.png" Visibility="{x:Bind vm:InGamePageViewModel.ConvertBlind(Blind, Model:BlindEnum.SmallBlind), Mode=OneWay}"/>
            <Image Grid.Column="2" Grid.Row="1" Width="50" Height="50" Source="/Assets/BigBlind.png" Visibility="{x:Bind vm:InGamePageViewModel.ConvertBlind(Blind, Model:BlindEnum.BigBlind), Mode=OneWay}"/>
            <Image Grid.Column="2" Grid.Row="1" Width="50" Height="50" Source="/Assets/NotBlind.png" Visibility="{x:Bind vm:InGamePageViewModel.ConvertBlind(Blind, Model:BlindEnum.NotBlind), Mode=OneWay}"/>

            <Border Width="Auto" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="2" BorderBrush="Black" BorderThickness="1" Background="{x:Bind vm:InGamePageViewModel.LastActionToColor(LastAction), Mode=OneWay}" Visibility="{x:Bind vm:InGamePageViewModel.LastActionVisibility(LastAction), Mode=OneWay}">
                <TextBlock Text="{x:Bind LastAction, Mode=OneWay}" Margin="5" FontSize="18" FontWeight="Bold"/>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PlayerBeforeEndOfRound" x:DataType="Model:Player">
        <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{x:Bind BgColorTransparent, Mode=OneWay}" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Visibility="{Binding viewModel.CardsDealt, ElementName=RootPage}">
                <Image Source="/Assets/cardEmpty.png" Width="100" Height="140"/>
                <Image Source="/Assets/cardEmpty.png" Width="100" Height="140"/>
            </StackPanel>

            <Border Grid.Column="0" Grid.Row="1" Width="50" Height="50" CornerRadius="10" BorderBrush="Black" BorderThickness="1" Margin="2">
                <Image Source="{x:Bind Model:Utils.PathToImage(ProfilePictureDir), Mode=OneWay}" Stretch="Fill"/>
            </Border>

            <Border Grid.Column="1" Grid.Row="1" Background="#66111111" HorizontalAlignment="Center">
                <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Run Text="$"/>
                    <Run Text="{x:Bind Chips, Mode=OneWay}"/>
                </TextBlock>
            </Border>

            <Image Grid.Column="2" Grid.Row="1" Width="50" Height="50" Source="/Assets/SmallBlind.png" Visibility="{x:Bind vm:InGamePageViewModel.ConvertBlind(Blind, Model:BlindEnum.SmallBlind), Mode=OneWay}"/>
            <Image Grid.Column="2" Grid.Row="1" Width="50" Height="50" Source="/Assets/BigBlind.png" Visibility="{x:Bind vm:InGamePageViewModel.ConvertBlind(Blind, Model:BlindEnum.BigBlind), Mode=OneWay}"/>
            <Image Grid.Column="2" Grid.Row="1" Width="50" Height="50" Source="/Assets/NotBlind.png" Visibility="{x:Bind vm:InGamePageViewModel.ConvertBlind(Blind, Model:BlindEnum.NotBlind), Mode=OneWay}"/>

            <Border Width="Auto" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="2" BorderBrush="Black" BorderThickness="1" Background="{x:Bind vm:InGamePageViewModel.LastActionToColor(LastAction), Mode=OneWay}" Visibility="{x:Bind vm:InGamePageViewModel.LastActionVisibility(LastAction), Mode=OneWay}">
                <TextBlock Text="{x:Bind LastAction, Mode=OneWay}" Margin="5" FontSize="18" FontWeight="Bold"/>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Gradient for buttons -->
    <LinearGradientBrush x:Key="GrayRedStripeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="DimGray" Offset="0.0" />
        <GradientStop Color="DimGray" Offset="0.2" />

        <GradientStop Color="Firebrick" Offset="0.2" />
        <GradientStop Color="Firebrick" Offset="0.4" />

        <GradientStop Color="DimGray" Offset="0.4" />
        <GradientStop Color="DimGray" Offset="0.6" />

        <GradientStop Color="Firebrick" Offset="0.6" />
        <GradientStop Color="Firebrick" Offset="0.8" />

        <GradientStop Color="DimGray" Offset="0.8" />
        <GradientStop Color="DimGray" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>
